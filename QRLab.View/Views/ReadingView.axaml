<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels"
             xmlns:c="using:QRLab.View.Controls"
             xmlns:icons="using:QRLab.View.Controls"
             xmlns:r="clr-namespace:QRLab.Core.Models.Recognition;assembly=QRLab.Core"
             xmlns:samples="clr-namespace:QRLab.View.ViewModels.Samples"
             xmlns:common="clr-namespace:QRLab.View.ViewModels.Common"
             xmlns:converters="using:QRLab.View.Converters"
             x:Class="QRLab.View.Views.ReadingView"
             x:DataType="vm:ReadingViewModel">
  <UserControl.Resources>
    <converters:RecognitionStatusBrushConverter x:Key="RecognitionStatusBrush"/>
    <DataTemplate x:Key="RecognitionChoiceTemplate" x:DataType="common:EnumOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
  </UserControl.Resources>
  <Grid Margin="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Остановить" Command="{Binding RunCancelCommand}" IsVisible="{Binding IsBusy}"/><Button Classes="primary" Command="{Binding RunCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="play"/>
            <TextBlock Text="Запустить распознавание"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
      <TextBlock Text="{Binding Results.Checked, StringFormat=Обработано: {0}}" Classes="muted"/>
      <TextBlock Text="{Binding Results.Average, StringFormat=Среднее: {0}}" Classes="muted"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100" Height="3"/>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,340" ColumnSpacing="12">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,34,*">
          <Border Classes="panelHead">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:SvgIcon Source="calc"/>
              <TextBlock Text="Результаты" Classes="heading"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="10" ColumnSpacing="12">
            <ComboBox 
              Name="RecognitionStatusFilter" Width="240" 
              ItemsSource="{Binding Results.Filters}" 
              ItemTemplate="{StaticResource RecognitionChoiceTemplate}" 
              SelectedValue="{Binding Results.Filter, Mode=TwoWay}" 
              SelectedValueBinding="{Binding Value, DataType=common:EnumOption}"/>
            <TextBox Grid.Column="1" Text="{Binding Results.Search, Mode=TwoWay}" PlaceholderText="⌕  Найти образец или содержимое" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding ExportCommand}" IsEnabled="{Binding !IsBusy}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="load"/>
                <TextBlock Text="Экспорт CSV"/>
              </StackPanel>
            </Button>
          </Grid>
          <Border Grid.Row="2" Background="#171C1E" Padding="12,0">
            <Grid ColumnDefinitions="90,175,*,135,65">
              <TextBlock Text="ОБРАЗЕЦ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="1" Text="РЕЗУЛЬТАТ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="2" Text="ЦЕПОЧКА МУТАЦИЙ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="3" Text="СОДЕРЖИМОЕ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="4" Text="ВРЕМЯ" Classes="muted" FontSize="9"/>
            </Grid>
          </Border>
          <ListBox Name="RecognitionResultsList" Grid.Row="3" ItemsSource="{Binding Results.Items}" SelectedItem="{Binding Results.SelectedResult, Mode=TwoWay}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
              <Style Selector="ListBoxItem.mismatch">
                <Setter Property="Background" Value="#493A19"/>
                <Setter Property="Foreground" Value="#F1CD70"/>
              </Style>
              <Style Selector="ListBoxItem.mismatch:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#665023"/>
                <Setter Property="Foreground" Value="#FFE29A"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" x:DataType="samples:SampleViewModel">
                <Setter Property="Classes.mismatch" Value="{Binding IsMismatch}"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="samples:SampleViewModel">
                <Grid ColumnDefinitions="90,175,*,135,65" MinHeight="36">
                  <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11"/>
                  <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Background="{Binding Result, Converter={StaticResource RecognitionStatusBrush}}" Opacity="0.16" CornerRadius="4"/>
                    <TextBlock Text="{Binding Status}" Foreground="{Binding Result, Converter={StaticResource RecognitionStatusBrush}}" FontSize="10" TextWrapping="Wrap" Padding="8,5"/>
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{Binding Chain}" FontSize="10" Foreground="#A7B2AF" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding Decoded}" FontSize="10" Classes="mono" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                  <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="11" Classes="mono"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="Нет подходящих образцов. Измените поиск или фильтр." IsVisible="{Binding Results.NoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted"/>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
        <Border Classes="card">
          <TabControl Name="RecognitionPanels" SelectedIndex="0" Padding="0">
            <TabItem>
              <TabItem.Header>
                <Grid Width="120" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="7 0 7 0">
                  <icons:SvgIcon Source="layers"/>
                  <TextBlock Grid.Column="1" Text="Сводка" TextWrapping="Wrap" FontSize="12"/>
                </Grid>
              </TabItem.Header>
              <ScrollViewer>
                <StackPanel Margin="14" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Не распознавался" Foreground="{x:Static converters:RecognitionStatusBrushConverter.NotRecognized}"/><TextBlock Grid.Column="1" Text="{Binding Results.NotRecognized}" Foreground="{x:Static converters:RecognitionStatusBrushConverter.NotRecognized}"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Код не найден" Foreground="{x:Static converters:RecognitionStatusBrushConverter.NotFound}"/><TextBlock Grid.Column="1" Text="{Binding Results.NotFound}" Foreground="{x:Static converters:RecognitionStatusBrushConverter.NotFound}"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Найден, не расшифрован" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Undecoded}"/><TextBlock Grid.Column="1" Text="{Binding Results.Undecoded}" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Undecoded}"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Найден, расшифрован" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Success}"/><TextBlock Grid.Column="1" Text="{Binding Results.Success}" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Success}"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Расшифрован неверно" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Mismatch}" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Results.Mismatch}" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Mismatch}" FontWeight="Bold"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Тайм-аут" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Timeout}"/><TextBlock Grid.Column="1" Text="{Binding Results.Timeout}" Foreground="{x:Static converters:RecognitionStatusBrushConverter.Timeout}"/></Grid>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem>
              <TabItem.Header>
                <Grid Width="120" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="7 0 7 0">
                  <icons:SvgIcon Source="config"/>
                  <TextBlock Grid.Column="1" Text="Параметры" TextWrapping="Wrap" FontSize="12"/>
                </Grid>
              </TabItem.Header>
              <ScrollViewer>
                <StackPanel Margin="14" Spacing="8">
                  <TextBlock Text="Декодер" Classes="label"/>
                  <TextBlock Text="{x:Static r:RecognitionDefaults.DecoderName}" Classes="accent"/>
                  <TextBlock Text="Тайм-аут, мс" Classes="label"/>
                  <NumericUpDown Value="{Binding Settings.Timeout, Mode=TwoWay}" Minimum="{Binding Settings.TimeoutRange.Minimum}" Maximum="{Binding Settings.TimeoutRange.Maximum}" Increment="50"/>
                  <CheckBox Content="Усиленный поиск" IsChecked="{Binding Settings.Enhanced, Mode=TwoWay}" FontSize="11"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>
        <Border Background="#244039" CornerRadius="5" Padding="16" Grid.Row="1">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="accent"/>
            <c:RasterPreview x:Name="ReadingPreview" Image="{Binding Workspace.SelectedSample.Image}" Height="110" AllowZoom="True"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="ЛКМ • колесо" Classes="muted" FontSize="9"/>
              <Button Grid.Column="1" Content="Сбросить вид" Classes="flat" Command="{Binding #ReadingPreview.ResetViewCommand}"/>
            </Grid>
            <TextBlock Text="{Binding Workspace.SelectedSample.Status}" Foreground="{Binding Workspace.SelectedSample.Result, Converter={StaticResource RecognitionStatusBrush}}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Workspace.SelectedSample.Content}" Classes="mono" TextTrimming="CharacterEllipsis"/>
            <Button Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="04" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="arrow-right"/>
                <TextBlock Text="Открыть сравнение"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.RowSpan="3" Background="#DD0B1011" IsVisible="{Binding IsExportOpen}">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel Spacing="16">
          <TextBlock Text="Экспорт результатов / CSV" FontSize="20"/>
          <TextBlock Text="Образец · результат · цепочка · содержимое · время" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Text="CSV-файл" Classes="label"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ExportDestination, Mode=TwoWay}" IsEnabled="{Binding !IsExporting}"/>
            <Button Grid.Column="1" Content="Обзор…" Click="BrowseCsvFile" IsEnabled="{Binding !IsExporting}"/>
          </Grid>
          <TextBlock Text="В таблицу войдут все образцы текущего набора." Classes="muted"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Отмена" Command="{Binding ExportCommand}" IsEnabled="{Binding !IsExporting}"/>
            <Button Classes="primary" Command="{Binding ConfirmExportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="load"/>
                <TextBlock Text="Экспортировать CSV"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="650" Padding="14" Margin="16"
            Background="#492B2B" CornerRadius="8" IsVisible="{Binding Workspace.HasError}">
      <TextBlock Text="{Binding Workspace.Error}" Foreground="#FFB4AB" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
