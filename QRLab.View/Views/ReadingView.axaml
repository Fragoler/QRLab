<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels"
             xmlns:c="using:QRLab.View.Controls"
             xmlns:icons="using:QRLab.View.Controls"
             xmlns:r="clr-namespace:QRLab.Core.Models.Recognition;assembly=QRLab.Core"
             xmlns:samples="clr-namespace:QRLab.View.ViewModels.Samples"
             xmlns:common="clr-namespace:QRLab.View.ViewModels.Common"
             x:Class="QRLab.View.Views.ReadingView"
             x:DataType="vm:ReadingViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="RecognitionChoiceTemplate" x:DataType="common:EnumOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
  </UserControl.Resources>
  <Grid Margin="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Classes="muted"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding ExportCommand}" IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="load"/>
            <TextBlock Text="Экспорт CSV"/>
          </StackPanel>
        </Button>
        <Button Content="Остановить" Command="{Binding RunCancelCommand}" IsVisible="{Binding IsBusy}"/><Button Classes="primary" Command="{Binding RunCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="play"/>
            <TextBlock Text="Запустить распознавание"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
      <TextBlock Text="{Binding Results.Checked, StringFormat=Обработано: {0}}" Classes="muted"/>
      <TextBlock Text="{Binding Results.Rate}" Classes="accent"/>
      <TextBlock Text="{Binding Results.Average, StringFormat=Среднее: {0}}" Classes="muted"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100" Height="3"/>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,280" ColumnSpacing="12">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,34,*,Auto">
          <Border Classes="panelHead">
            <TextBlock Text="Результаты распознавания" Classes="heading"/>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="10" ColumnSpacing="12">
            <ListBox Classes="tabs" ItemsSource="{Binding Results.Filters}" ItemTemplate="{StaticResource RecognitionChoiceTemplate}" SelectedValue="{Binding Results.Filter, Mode=TwoWay}" SelectedValueBinding="{Binding Value, DataType=common:EnumOption}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
            <TextBox Grid.Column="1" Text="{Binding Results.Search, Mode=TwoWay}" PlaceholderText="⌕  Найти образец или содержимое" VerticalAlignment="Center"/>
          </Grid>
          <Border Grid.Row="2" Background="#171C1E" Padding="12,0">
            <Grid ColumnDefinitions="105,100,*,165,85">
              <TextBlock Text="ОБРАЗЕЦ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="1" Text="РЕЗУЛЬТАТ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="2" Text="ЦЕПОЧКА МУТАЦИЙ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="3" Text="СОДЕРЖИМОЕ" Classes="muted" FontSize="9"/>
              <TextBlock Grid.Column="4" Text="ВРЕМЯ" Classes="muted" FontSize="9"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="3" ItemsSource="{Binding Results.Items}" SelectedItem="{Binding Results.SelectedResult, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="samples:SampleViewModel">
                <Grid ColumnDefinitions="105,100,*,165,85" MinHeight="28">
                  <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11"/>
                  <Border Grid.Column="1" Background="#293E38" CornerRadius="3" Padding="6,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Status}" Foreground="#96D3BA" FontSize="10"/>
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding Chain}" FontSize="10" Foreground="#A7B2AF" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding Decoded}" FontSize="10" Classes="mono"/>
                  <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="11" Classes="mono"/>
                  <Border Grid.Column="1" IsVisible="{Binding IsFailure}" Background="#422C2C" CornerRadius="3" Padding="6,4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <icons:SvgIcon Source="cross-in-circle" Foreground="#E58A86" Width="11" Height="11"/>
                      <TextBlock Text="{Binding Status}" Classes="danger" FontSize="10"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="Нет подходящих образцов. Измените поиск или фильтр." IsVisible="{Binding Results.NoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted"/>
          <Border Grid.Row="4" Padding="14">
            <TextBlock Text="Выберите строку, чтобы открыть образец в редакторе мутаций. Поиск работает по имени и исходному содержимому." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <Border Classes="card">
              <StackPanel>
                <Border Classes="panelHead">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <icons:SvgIcon Source="config"/>
                    <TextBlock Text="Параметры прогона" Classes="heading"/>
                  </StackPanel>
                </Border>
                <StackPanel Margin="14" Spacing="8">
                  <TextBlock Text="Декодер" Classes="label"/>
                  <TextBlock Text="{x:Static r:RecognitionDefaults.DecoderName}" Classes="accent"/>
                  <TextBlock Text="Тайм-аут, мс" Classes="label"/>
                  <NumericUpDown Value="{Binding Settings.Timeout, Mode=TwoWay}" Minimum="{Binding Settings.TimeoutRange.Minimum}" Maximum="{Binding Settings.TimeoutRange.Maximum}" Increment="50"/>
                  <CheckBox Content="Усиленный поиск" IsChecked="{Binding Settings.Enhanced, Mode=TwoWay}" FontSize="11"/>
                  <Border Classes="divider"/>
                  <TextBlock Text="Настройки применяются при запуске нового прогона." Classes="muted" TextWrapping="Wrap" FontSize="10"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Margin="14" Spacing="12">
                <TextBlock Text="Сводка распознавания" Classes="heading"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Ошибки" Classes="muted"/>
                  <TextBlock Grid.Column="1" Text="{Binding Results.Failed}" Classes="danger"/>
                </Grid>
                <ProgressBar Maximum="{Binding Workspace.Samples.Count}" Value="{Binding Results.Failed}" Foreground="#E58A86" Height="4"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Тайм-аут" Classes="muted"/>
                  <TextBlock Grid.Column="1" Text="{Binding Results.Timeout}" Classes="danger"/>
                </Grid>
                <ProgressBar Maximum="{Binding Workspace.Samples.Count}" Value="{Binding Results.Timeout}" Foreground="#E58A86" Height="4"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Успешно считано" Classes="muted"/>
                  <TextBlock Grid.Column="1" Text="{Binding Results.Success}" Classes="accent"/>
                </Grid>
                <ProgressBar Maximum="{Binding Workspace.Samples.Count}" Value="{Binding Results.Success}" Foreground="#75D9BE" Height="4"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Background="#244039" CornerRadius="5" Padding="16" Grid.Row="1">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="accent"/>
            <c:RasterPreview x:Name="ReadingPreview" Image="{Binding Workspace.SelectedSample.Image}" Height="145" AllowZoom="True"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="ЛКМ • колесо" Classes="muted" FontSize="9"/>
              <Button Grid.Column="1" Content="Сбросить вид" Classes="flat" Command="{Binding #ReadingPreview.ResetViewCommand}"/>
            </Grid>
            <TextBlock Text="{Binding Workspace.SelectedSample.Content}" Classes="mono"/>
            <Button Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="02" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="arrow-right"/>
                <TextBlock Text="Открыть мутации"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.RowSpan="3" Background="#DD0B1011" IsVisible="{Binding IsExportOpen}">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel Spacing="16">
          <TextBlock Text="Экспорт результатов / CSV" FontSize="20"/>
          <TextBlock Text="Образец · результат · цепочка · содержимое · время" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Text="CSV-файл" Classes="label"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ExportDestination, Mode=TwoWay}" IsEnabled="{Binding !IsExporting}"/>
            <Button Grid.Column="1" Content="Обзор…" Click="BrowseCsvFile" IsEnabled="{Binding !IsExporting}"/>
          </Grid>
          <TextBlock Text="В таблицу войдут все образцы текущего набора." Classes="muted"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Отмена" Command="{Binding ExportCommand}" IsEnabled="{Binding !IsExporting}"/>
            <Button Classes="primary" Command="{Binding ConfirmExportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="load"/>
                <TextBlock Text="Экспортировать CSV"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="650" Padding="14" Margin="16"
            Background="#492B2B" CornerRadius="8" IsVisible="{Binding Workspace.HasError}">
      <TextBlock Text="{Binding Workspace.Error}" Foreground="#FFB4AB" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
