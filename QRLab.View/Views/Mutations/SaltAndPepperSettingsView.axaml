<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels.Mutations"
             xmlns:local="using:QRLab.View.Views.Mutations"
             x:Class="QRLab.View.Views.Mutations.SaltAndPepperSettingsView"
             x:DataType="vm:SaltAndPepperSettingsViewModel">
  <StackPanel Spacing="8">
    <local:NumericMutationParameter Label="Плотность шума, %" Value="{Binding DensityPercent, Mode=TwoWay}" Minimum="0" Maximum="100"/>
    <local:NumericMutationParameter Label="Доля белых точек, %" Value="{Binding SaltPercent, Mode=TwoWay}" Minimum="0" Maximum="100"/>
    
    <Border Classes="divider"/>
    
    <TextBlock Text="Семя" Classes="label"/>
    <NumericUpDown Value="{Binding Seed, Mode=TwoWay}" Minimum="0" Maximum="2147483647" FormatString="0"/>
    <CheckBox Content="Случайный для каждого" IsChecked="{Binding RandomForEachSample, Mode=TwoWay}"
              ToolTip.Tip="Семя = базовое семя + номер образца в пакете"/>
  </StackPanel>
</UserControl>
