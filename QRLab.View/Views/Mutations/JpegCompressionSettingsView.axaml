<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels.Mutations"
             x:Class="QRLab.View.Views.Mutations.JpegCompressionSettingsView"
             x:DataType="vm:JpegCompressionSettingsViewModel">
  <StackPanel Spacing="8">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="Качество JPEG" Classes="label"/>
      <NumericUpDown Grid.Column="1" Value="{Binding Quality, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1" FormatString="0"/>
    </Grid>
    <Slider Minimum="0" Maximum="100" Value="{Binding Quality, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
    <TextBlock Text="Меньше качество — сильнее сжатие и потери" Classes="muted" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
