<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels"
             xmlns:settings="using:QRLab.View.ViewModels.Mutations"
             xmlns:local="using:QRLab.View.Views.Mutations"
             xmlns:icons="using:QRLab.View.Controls"
             x:Class="QRLab.View.Views.Mutations.MutationSettingsView"
             x:DataType="vm:MutationsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type settings:MarkerSettingsViewModel}"><local:MarkerSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type settings:ContrastSettingsViewModel}"><local:ContrastSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type settings:JpegCompressionSettingsViewModel}"><local:JpegCompressionSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type settings:GaussianBlurSettingsViewModel}"><local:GaussianBlurSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type settings:SaltAndPepperSettingsViewModel}"><local:SaltAndPepperSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type settings:OcclusionSettingsViewModel}"><local:OcclusionSettingsView/></DataTemplate>
  </UserControl.DataTemplates>
  <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="7">
      <icons:SvgIcon Source="config"/>
      <TextBlock Text="Параметры операции" Classes="heading"/>
    </StackPanel>
    <ContentControl Content="{Binding SelectedSettings}" HorizontalContentAlignment="Stretch"/>
  </StackPanel>
</UserControl>
