<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels" xmlns:local="using:QRLab.View.Views.Mutations"
             xmlns:p="using:QRLab.View.Presentation" x:Class="QRLab.View.Views.Mutations.MutationSettingsView"
             x:DataType="vm:MutationsViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="Параметры операции" Classes="heading"/>
    <local:PerspectiveSettingsView IsVisible="{Binding IsPerspective}"/>
    <local:GaussianBlurSettingsView IsVisible="{Binding IsBlur}"/>
    <local:SaltAndPepperSettingsView IsVisible="{Binding IsSaltAndPepper}"/>
    <local:OcclusionSettingsView IsVisible="{Binding IsOcclusion}"/>
  </StackPanel>
</UserControl>
