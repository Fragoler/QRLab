<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels.Mutations"
             xmlns:local="using:QRLab.View.Views.Mutations"
             x:Class="QRLab.View.Views.Mutations.GaussianBlurSettingsView"
             x:DataType="vm:GaussianBlurSettingsViewModel">
  <StackPanel>
    <local:NumericMutationParameter Label="Сила размытия, σ" Value="{Binding Sigma, Mode=TwoWay}" Minimum="0" Maximum="50"/>
  </StackPanel>
</UserControl>
