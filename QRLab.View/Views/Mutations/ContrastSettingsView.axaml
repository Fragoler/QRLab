<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels.Mutations"
             x:Class="QRLab.View.Views.Mutations.ContrastSettingsView"
             x:DataType="vm:ContrastSettingsViewModel">
  <StackPanel Spacing="8">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="Снижение контраста" Classes="label"/>
      <NumericUpDown Grid.Column="1" Value="{Binding Reduction, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00"/>
    </Grid>
    <Slider Minimum="0" Maximum="1" Value="{Binding Reduction, Mode=TwoWay}"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="Центр яркости" Classes="label"/>
      <NumericUpDown Grid.Column="1" Value="{Binding Center, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00"/>
    </Grid>
    <Slider Minimum="0" Maximum="1" Value="{Binding Center, Mode=TwoWay}"/>
  </StackPanel>
</UserControl>
