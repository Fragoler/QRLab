<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels.Mutations"
             xmlns:local="using:QRLab.View.Views.Mutations"
             xmlns:common="clr-namespace:QRLab.View.ViewModels.Common"
             x:Class="QRLab.View.Views.Mutations.OcclusionSettingsView"
             x:DataType="vm:OcclusionSettingsViewModel">
  <StackPanel Spacing="6">
    <TextBlock Text="Форма области" Classes="label"/>
    <ComboBox ItemsSource="{Binding OcclusionShapes}" SelectedValue="{Binding Shape, Mode=TwoWay}"
              SelectedValueBinding="{Binding Value, DataType=common:EnumOption}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="common:EnumOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Цвет, HEX (#RRGGBB)" Classes="label"/>
    <TextBox Text="{Binding Color, Mode=TwoWay}" PlaceholderText="#808080"/>
    <local:NumericMutationParameter Label="Центр X, %" Value="{Binding CenterX, Mode=TwoWay}" Minimum="0" Maximum="100"/>
    <local:NumericMutationParameter Label="Центр Y, %" Value="{Binding CenterY, Mode=TwoWay}" Minimum="0" Maximum="100"/>
    <local:NumericMutationParameter Label="Ширина, %" Value="{Binding Width, Mode=TwoWay}" Minimum="0" Maximum="100"/>
    <local:NumericMutationParameter Label="Высота, %" Value="{Binding Height, Mode=TwoWay}" Minimum="0" Maximum="100"/>
    <local:NumericMutationParameter Label="Наклон, °" Value="{Binding Angle, Mode=TwoWay}" Minimum="-180" Maximum="180"/>
  </StackPanel>
</UserControl>
