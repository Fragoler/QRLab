<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QRLab.View.ViewModels"
        xmlns:views="using:QRLab.View.Views"
        xmlns:icons="using:QRLab.View.Controls"
        xmlns:generation="clr-namespace:QRLab.View.ViewModels.Generation"
        x:Class="QRLab.View.Views.MainWindow"
        Icon="/Assets/QRLab.ico"
        x:DataType="vm:MainWindowViewModel" 
        Title="QRLab — лаборатория устойчивости кодов" 
        Width="1440" Height="940" 
        MinWidth="1180" MinHeight="760" 
        WindowDecorations="None" 
        CanResize="True">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type generation:GenerationViewModel}">
      <views:GenerationView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MutationsViewModel}">
      <views:MutationsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReadingViewModel}">
      <views:ReadingView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ComparisonViewModel}">
      <views:ComparisonView/>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="42,*,30,76">
    <Border x:Name="TitleBar" Background="#1A1F21" BorderBrush="#303839" BorderThickness="0,0,0,1" Padding="12,0" PointerPressed="TitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="WindowMenuButton"
                  Classes="flat" 
                  Padding="4"
                  HorizontalContentAlignment="Center" 
                  VerticalContentAlignment="Center"
                  ToolTip.Tip="Управление окном" 
                  AutomationProperties.Name="Меню окна">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="ExitWindowMenuItem" Header="Выход" Click="ExitWindowClick"/>
                <MenuItem x:Name="MinimizeWindowMenuItem" Header="Свернуть" Click="MinimizeWindowClick"/>
                <MenuItem x:Name="MaximizeWindowMenuItem" Header="Развернуть" Click="MaximizeWindowClick"/>
              </MenuFlyout>
            </Button.Flyout>
            <icons:SvgIcon Source="logo" Width="20" Height="20" Foreground="{DynamicResource ActiveIconBrush}"/>
          </Button>
          <TextBlock Text="QRLab" FontWeight="Bold" FontSize="15"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="●" Classes="accent" FontSize="10" LetterSpacing="1"/>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding SelectedScreen}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Border Grid.Row="2" BorderBrush="#303839" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding Workspace.SetName}" Classes="muted" FontSize="10" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding Workspace.Notice}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="16,0" Classes="muted" FontSize="10"/>
        <TextBlock Grid.Column="2" Text="By Fragoler / DyN4m1ck" Classes="muted" FontSize="10"/>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="#0E1213">
      <ListBox Classes="nav" HorizontalAlignment="Center" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen, Mode=TwoWay}" SelectionMode="Single">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScreenViewModel">
            <StackPanel Spacing="7">
              <icons:SvgIcon Source="{Binding Number, Converter={StaticResource IconName}}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
