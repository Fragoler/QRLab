<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels"
             xmlns:c="using:QRLab.View.Controls"
             xmlns:icons="using:QRLab.View.Controls"
             xmlns:recognition="clr-namespace:QRLab.Core.Models.Recognition;assembly=QRLab.Core"
             xmlns:converters="using:QRLab.View.Converters"
             x:Class="QRLab.View.Views.ComparisonView"
             x:DataType="vm:ComparisonViewModel">
  <UserControl.Resources>
    <converters:RecognitionStatusBrushConverter x:Key="RecognitionStatusBrush"/>
  </UserControl.Resources>
  <Grid Margin="18" RowDefinitions="Auto,*" RowSpacing="16">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="12">
      <Grid RowDefinitions="*,Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Classes="panelHead"><TextBlock Text="А · Матрица энкодера" Classes="heading"/></Border>
              <c:BitmapPreview Grid.Row="1" Name="OriginalBitmapPreview" Image="{Binding OriginalBitmap}" Layout="{Binding Layout}" HighlightZones="{Binding HighlightZones}" HighlightCodewords="{Binding HighlightCodewords}" HighlightBlocks="{Binding HighlightBlocks}" Zoom="{Binding Zoom, Mode=TwoWay}" PanOffset="{Binding PanOffset, Mode=TwoWay}" Margin="16" MinHeight="180"/>
              <TextBlock Grid.Row="1" Name="OriginalMatrixPlaceholder" IsVisible="{Binding !HasOriginalBitmap}" Text="Нет матрицы энкодера" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="16"/>
              <Border Grid.Row="2" Padding="12"><TextBlock Text="{Binding OriginalDimensions}" Classes="muted"/></Border>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Classes="panelHead"><TextBlock Text="Б · Матрица считывания" Classes="heading"/></Border>
              <c:BitmapPreview Grid.Row="1" Name="FinalBitmapPreview" Image="{Binding FinalBitmap}" Reference="{Binding OriginalBitmap}" Layout="{Binding Layout}" HighlightZones="{Binding HighlightZones}" HighlightCodewords="{Binding HighlightCodewords}" HighlightBlocks="{Binding HighlightBlocks}" HighlightChanges="{Binding HighlightChanges}" ShowModules="{Binding ShowResultCode}" Zoom="{Binding Zoom, Mode=TwoWay}" PanOffset="{Binding PanOffset, Mode=TwoWay}" Margin="16" MinHeight="180"/>
              <TextBlock Grid.Row="1" Name="FinalMatrixPlaceholder" IsVisible="{Binding !HasFinalBitmap}" Text="{Binding FinalPlaceholder}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="16"/>
              <Border Grid.Row="2" Padding="12"><TextBlock Text="{Binding FinalDimensions}" Classes="muted"/></Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="1"  ColumnDefinitions="*, Auto" ColumnSpacing="12">
          <Border  Classes="card" Padding="12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
              <TextBlock Text="ЛКМ • колесо" Classes="muted"/>
              <TextBlock Grid.Column="1" Text="{Binding ZoomLabel}" Width="48"/>
              <Button Grid.Column="2" Content="Сбросить вид" Command="{Binding ResetZoomCommand}"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="12">
            <Grid MinWidth="140" ColumnDefinitions="Auto,*,Auto">
              <Button HorizontalAlignment="Left" Classes="flat" Command="{Binding Workspace.PreviousCommand}" ToolTip.Tip="Предыдущий образец">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right" Width="12" Height="12" RenderTransform="rotate(180deg)" RenderTransformOrigin="50%,50%"/>
                </StackPanel>
              </Button>
              <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{Binding Workspace.Position}" Classes="muted" Margin="10,0"/>
              <Button Grid.Column="2" HorizontalAlignment="Right" Classes="flat" Command="{Binding Workspace.NextCommand}" ToolTip.Tip="Следующий образец">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right" Width="12" Height="12"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,*">
              <Border Classes="panelHead">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="heading"/>
                  <TextBlock Grid.Column="1" Text="{Binding Workspace.SelectedSample.Status}" 
                             Foreground="{Binding Workspace.SelectedSample.Result, Converter={StaticResource RecognitionStatusBrush}}" 
                             TextWrapping="Wrap"
                             ToolTip.Tip="{Binding Workspace.SelectedSample.Result.Error}"/>
                </Grid>
              </Border>
              <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="14" ColumnSpacing="10">
                <Grid RowDefinitions="*,Auto" RowSpacing="10">
                  <StackPanel  Spacing="10">
                    <TextBlock Text="{Binding Workspace.SelectedSample.Format}" Classes="accent"/>
                    <TextBlock Text="{Binding Workspace.SelectedSample.Chain}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Workspace.SelectedSample.Time, StringFormat='Обработка: {0}'}" Classes="muted"/>
                  </StackPanel>
                  <Button Grid.Row="1" VerticalAlignment="Bottom" Content="Открыть в мутациях →" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="02"/>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="Ожидаемое содержимое" Classes="label"/>
                  <TextBlock Text="{Binding Workspace.SelectedSample.Content}" TextWrapping="Wrap" MaxHeight="40" Classes="mono"/>
                  <TextBlock Text="Распознано" Classes="label"/>
                  <TextBlock Text="{Binding Workspace.SelectedSample.Decoded}" TextWrapping="Wrap" MaxHeight="40" Classes="mono"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="14">
            <Grid ColumnDefinitions="*,*">
              <Grid RowDefinitions="*,Auto">
                <StackPanel Spacing="10">
                  <CheckBox Name="ShowResultCodeCheckBox" Content="Код результата" IsChecked="{Binding ShowResultCode}" ToolTip.Tip="Показывать модули кода на правой матрице. При отключении цветная подсветка остаётся видимой."/>
                  <CheckBox Content="Изменения" IsChecked="{Binding HighlightChanges}" IsEnabled="{Binding CanCompare}"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
                  <Button Content="Запустить распознавание" Classes="primary" Command="{Binding Reading.RunCommand}"/>
                  <Button Grid.Column="1" Content="Остановить" IsVisible="{Binding Reading.IsBusy}" Command="{Binding Reading.RunCancelCommand}"/>
                </Grid>
              </Grid>
              <StackPanel Grid.Column="1" Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <CheckBox Content="Зоны QR" IsChecked="{Binding HighlightZones}" IsEnabled="{Binding IsQr}"/>
                  <Button Grid.Column="1" Name="QrLegendButton" Classes="flat" Padding="5" IsEnabled="{Binding IsQr}" ToolTip.Tip="Легенда зон QR" AutomationProperties.Name="Легенда зон QR">
                    <c:SvgIcon Source="info" Width="16" Height="16"/>
                    <Button.Flyout>
                      <Flyout Placement="LeftEdgeAlignedTop">
                        <StackPanel Spacing="8" Margin="4">
                          <TextBlock Text="Легенда зон QR" Classes="heading"/>
                          <TextBlock Text="Поисковые узоры" Foreground="#4696E6"/>
                          <TextBlock Text="Выравнивающие узоры" Foreground="#AE6FE0"/>
                          <TextBlock Text="Метки времени" Foreground="#F2AA46"/>
                          <TextBlock Text="Информация формата" Foreground="#EBCD46"/>
                          <TextBlock Text="Информация версии (v7+)" Foreground="#E169AA"/>
                          <TextBlock Text="Фиксированный модуль" Foreground="#DC5050"/>
                          <TextBlock Text="Разделители" Foreground="#82909A"/>
                          <TextBlock Text="Кодовые слова" Foreground="#64C3D7"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <CheckBox Name="HighlightCodewordsCheckBox" Content="Кодовые слова" IsChecked="{Binding HighlightCodewords}"/>
                <CheckBox Name="HighlightBlocksCheckBox" Content="Блоки коррекции" IsChecked="{Binding HighlightBlocks}" IsEnabled="{Binding HasBlocks}" ToolTip.Tip="Каждый блок имеет свой цвет с тёмным и светлым оттенками модулей. Отключает подсветку кодовых слов."/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
        <Border Grid.Column="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="panelHead"><TextBlock Text="Данные распознавания" Classes="heading"/></Border>
            <ScrollViewer Grid.Row="1" Padding="14,14,24,14" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="9">
                <TextBlock Text="Нет данных" IsVisible="{Binding !HasInspection}" Classes="muted"/>
                <ItemsControl Name="DamageDiagnostics" ItemsSource="{Binding Sections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="recognition:InspectionSection">
                      <Border Background="#171C1E" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding Title}" Classes="heading" TextWrapping="Wrap"/>
                          <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="recognition:InspectionParameter">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4">
                                  <TextBlock Text="{Binding Name}" Classes="muted" TextWrapping="Wrap"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
    </Grid>
  </Grid>
</UserControl>
