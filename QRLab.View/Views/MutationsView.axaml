<UserControl xmlns="https://github.com/avaloniaui" 
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
              xmlns:vm="using:QRLab.View.ViewModels"
              xmlns:c="using:QRLab.View.Controls"
              xmlns:icons="using:QRLab.View.Controls"
              xmlns:settings="using:QRLab.View.Views.Mutations"
              xmlns:mutations="clr-namespace:QRLab.View.ViewModels.Mutations"
              xmlns:common="clr-namespace:QRLab.View.ViewModels.Common"
              x:Class="QRLab.View.Views.MutationsView"
              x:DataType="vm:MutationsViewModel">
  <Grid Margin="18" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Отменить" Command="{Binding UndoCommand}"/>
        <Button Content="Вернуть" Command="{Binding RedoCommand}"/>
        <Button Classes="primary" Content="Применить к набору" Command="{Binding ApplyCommand}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,260" ColumnSpacing="12">
      <Border Classes="card">
        <StackPanel>
          <Border Classes="panelHead"><TextBlock Text="Алгоритмические искажения" Classes="heading"/></Border>
          <StackPanel Margin="14" Spacing="12">
            <ItemsControl ItemsSource="{Binding AvailableMutations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="common:EnumOption">
                  <Button Command="{ReflectionBinding $parent[UserControl].DataContext.AddCommand}" CommandParameter="{Binding Value}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <c:SvgIcon Source="{Binding Icon}"/><TextBlock Grid.Column="1" Text="{Binding Name}"/>
                      <c:SvgIcon Grid.Column="2" Source="plus" Width="12" Height="12"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,170" RowSpacing="12">
        <Border Classes="card">
          <Grid RowDefinitions="*,40,52">
            <Border Grid.Row="0" Background="#0D1112" Padding="30">
              <c:RasterPreview x:Name="MutationPreview" Image="{Binding PreviewImage}" AllowZoom="True"/>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,0">
              <TextBlock Text="ЛКМ — перемещение  •  Колесо — масштаб" Classes="muted" FontSize="10"/>
              <Button x:Name="ResetMutationViewport" Grid.Column="1" Content="Сбросить вид" Classes="flat" Command="{Binding #MutationPreview.ResetViewCommand}"/>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,0">
              <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="mono"/>
              <Button Grid.Column="1" Classes="flat" Command="{Binding Workspace.PreviousCommand}" ToolTip.Tip="Предыдущий образец">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right" Width="12" Height="12" RenderTransform="rotate(180deg)" RenderTransformOrigin="50%,50%"/>
                </StackPanel>
              </Button>
              <TextBlock Grid.Column="2" Text="{Binding Workspace.Position}" Classes="muted" Margin="10,0"/>
              <Button Grid.Column="3" Classes="flat" Command="{Binding Workspace.NextCommand}" ToolTip.Tip="Следующий образец">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right" Width="12" Height="12"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="panelHead"><TextBlock Text="Промежуточные кадры" Classes="heading"/></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame, Mode=TwoWay}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="mutations:OperationViewModel">
                  <StackPanel Width="105" Spacing="6">
                    <c:RasterPreview Height="70" Image="{Binding Image}"/>
                    <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Number}" Classes="muted" FontSize="9"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="*,400,Auto" RowSpacing="10">
          <Border Grid.Row="0" Classes="card">
            <Grid RowDefinitions="Auto,200,*">
              <Border Classes="panelHead"><TextBlock Text="Последовательность операций" Classes="heading"/></Border>
                <ListBox Grid.Row="1"  ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mutations:OperationViewModel">
                      <Grid ColumnDefinitions="24,*">
                        <TextBlock Text="{Binding Number}" Classes="accent" FontSize="10"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Name}" FontSize="12"/>
                          <TextBlock Text="{Binding Details}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
          </Border>
        <Border Grid.Row="1" Classes="card">
          <ScrollViewer Padding="14">
            <settings:MutationSettingsView/>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Classes="card">
          <StackPanel Margin="14" Spacing="8">
            <Button Content="Сбросить цепочку" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch"/>
            <Button Content="К распознаванию" Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="03" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="650" Margin="16" Padding="14"
            Background="#492B2B" CornerRadius="8" IsVisible="{Binding Workspace.HasError}">
      <TextBlock Text="{Binding Workspace.Error}" Foreground="#FFB4AB" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
